<?xml version="1.0" ?>
<!--
  Industrial warehouse world for Nav2 testing.
  20 m × 20 m room with perimeter walls, two rows of shelving,
  and scattered crates to create a realistic obstacle environment.
-->
<sdf version="1.8">
  <world name="industrial">

    <!-- Gazebo Fortress (Ignition 6) system plugins -->
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-contact-system"
            name="ignition::gazebo::systems::Contact"/>
    <plugin filename="libignition-gazebo-sensors-system.so"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ── Lighting ─────────────────────────────────────────── -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.1 -0.9</direction>
    </light>

    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.5 0.5 0.6 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>1000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
      <direction>0.3 -0.1 -0.9</direction>
    </light>

    <!-- ── Ground plane ─────────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Perimeter walls (20 m × 20 m room, 3 m tall, 0.2 m thick) ── -->

    <!-- North wall  y=+10 -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 10 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>20.4 0.2 3.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>20.4 0.2 3.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South wall  y=-10 -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -10 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>20.4 0.2 3.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>20.4 0.2 3.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East wall  x=+10 -->
    <model name="wall_east">
      <static>true</static>
      <pose>10 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 20.0 3.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 20.0 3.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West wall  x=-10 -->
    <model name="wall_west">
      <static>true</static>
      <pose>-10 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 20.0 3.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 20.0 3.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Shelving rows ─────────────────────────────────────── -->
    <!--
      Layout (top view, y-axis up):
        Row A — x ≈ -6.5  (west side)   3 shelves along y
        Row B — x ≈ -4.5  (west side)   3 shelves along y
        Row C — x ≈ +4.5  (east side)   3 shelves along y
        Row D — x ≈ +6.5  (east side)   3 shelves along y
      Central corridor: x ∈ [-3, +3]  (6 m wide)
      Side aisles between rows and walls: ~1.3 m
    -->

    <!-- Row A: west outer row -->
    <model name="shelf_A1"><static>true</static><pose>-6.5 -6 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.0 4.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.0 4.0 2.0</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_A2"><static>true</static><pose>-6.5 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.0 4.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.0 4.0 2.0</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_A3"><static>true</static><pose>-6.5 6 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.0 4.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.0 4.0 2.0</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Row B: west inner row -->
    <model name="shelf_B1"><static>true</static><pose>-4.5 -6 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.0 4.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.0 4.0 2.0</size></box></geometry>
          <material><ambient>0.45 0.35 0.2 1</ambient><diffuse>0.45 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_B2"><static>true</static><pose>-4.5 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.0 4.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.0 4.0 2.0</size></box></geometry>
          <material><ambient>0.45 0.35 0.2 1</ambient><diffuse>0.45 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_B3"><static>true</static><pose>-4.5 6 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.0 4.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.0 4.0 2.0</size></box></geometry>
          <material><ambient>0.45 0.35 0.2 1</ambient><diffuse>0.45 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Row C: east inner row -->
    <model name="shelf_C1"><static>true</static><pose>4.5 -6 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.0 4.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.0 4.0 2.0</size></box></geometry>
          <material><ambient>0.45 0.35 0.2 1</ambient><diffuse>0.45 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_C2"><static>true</static><pose>4.5 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.0 4.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.0 4.0 2.0</size></box></geometry>
          <material><ambient>0.45 0.35 0.2 1</ambient><diffuse>0.45 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_C3"><static>true</static><pose>4.5 6 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.0 4.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.0 4.0 2.0</size></box></geometry>
          <material><ambient>0.45 0.35 0.2 1</ambient><diffuse>0.45 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Row D: east outer row -->
    <model name="shelf_D1"><static>true</static><pose>6.5 -6 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.0 4.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.0 4.0 2.0</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_D2"><static>true</static><pose>6.5 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.0 4.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.0 4.0 2.0</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_D3"><static>true</static><pose>6.5 6 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.0 4.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.0 4.0 2.0</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Crates (0.5 m cube obstacles) ────────────────────── -->
    <model name="crate_1"><static>true</static><pose>-2.0  3.5 0.25 0 0 0.4</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.1 1</ambient><diffuse>0.6 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="crate_2"><static>true</static><pose> 2.0  3.5 0.25 0 0 -0.3</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.1 1</ambient><diffuse>0.6 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="crate_3"><static>true</static><pose>-1.5 -4.0 0.25 0 0 0.1</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.1 1</ambient><diffuse>0.6 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="crate_4"><static>true</static><pose> 1.5 -4.0 0.25 0 0 0.7</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.1 1</ambient><diffuse>0.6 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="crate_5"><static>true</static><pose> 0.0  7.5 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.1 1</ambient><diffuse>0.6 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="crate_6"><static>true</static><pose> 0.0 -7.5 0.25 0 0 0.5</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.1 1</ambient><diffuse>0.6 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="crate_7"><static>true</static><pose>-8.0  2.0 0.25 0 0 0.2</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.1 1</ambient><diffuse>0.6 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="crate_8"><static>true</static><pose> 8.0 -2.0 0.25 0 0 -0.4</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.1 1</ambient><diffuse>0.6 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
