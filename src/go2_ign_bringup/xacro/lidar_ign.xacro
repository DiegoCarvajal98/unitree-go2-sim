<?xml version="1.0"?>
<!--
  2D LiDAR for Gazebo Fortress (Ignition 6).
  Geometry copied from go2_description/xacro/laser.xacro.
  The Classic libgazebo_ros_ray_sensor plugin is replaced by a native
  Ignition sensor whose topic is bridged to ROS via ros_ign_bridge.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <joint name="chassis_front_laser_joint" type="fixed">
    <axis xyz="0 0 1"/>
    <origin rpy="0 0 0" xyz="0.225 0 0.105"/>
    <parent link="base_link"/>
    <child link="front_laser"/>
  </joint>

  <link name="front_laser">
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><box size="0.1 0.1 0.1"/></geometry>
    </collision>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find go2_description)/meshes/hokuyo.dae"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="1e-5"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <!--
    type="ray" is the Ignition Gazebo Fortress CPU-based lidar sensor.
    It publishes ignition.msgs.LaserScan to the topic set below.
    - Do NOT use <frame_id>: it is not valid SDF and breaks sensor conversion.
    - Do NOT use type="gpu_lidar": requires a GPU render context that may not
      be available inside the container and uses <lidar> not <ray>.
    - The absolute topic /scan is bridged to ROS by gz_bridge.yaml.
  -->
  <gazebo reference="front_laser">
    <sensor name="front_laser_sensor" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>25.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <topic>/scan</topic>
    </sensor>
  </gazebo>

</robot>
